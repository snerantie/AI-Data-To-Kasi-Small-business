# Copy this file to `.env.local` for local development, and set these
# same two variables as environment variables in your Vercel / Netlify
# project settings for production.
#
# If BOTH are set, KasiKash uses Supabase as the source of truth
# (auth + Postgres, synced across devices).
# If EITHER is missing, KasiKash falls back to localStorage-only mode
# (single-device demo mode, no auth).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
